{
  "openapi": "3.1.0",
  "info": {
    "title": "AB-BRAINMASTER-ORCA observation API",
    "version": "0.1.0",
    "description": "Seven read operations through the upstream RuntimeClient. No execution or generic RPC endpoint. HTTP request bodies are limited to 16384 bytes; responses to 4194304 bytes. Browser Origin headers are denied. Default concurrency is 4; default runtime timeout is 15000 ms. Client cancellation abandons the observation and keeps its server slot until the bounded runtime request settles."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "8080",
          "description": "Operator-selected loopback port; deployment requires an explicitly assigned host port."
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
